@page "/forms"

<PageTitle>35p10.Blazor Demo - Forms</PageTitle>

<KText Variant="KTextVariant.Title">Forms</KText>
<KText Variant="KTextVariant.Lead">Bindable wrapper components (<KCode>Value</KCode>/<KCode>ValueChanged</KCode>, so <KCode>@@bind-Value</KCode> works) &mdash; no <KCode>EditForm</KCode>/<KCode>EditContext</KCode> required.</KText>

<DemoSection Title="KTextInput" Code="@TextInputSnippet">
    <Description>Wraps <KCode>&lt;input&gt;</KCode>; <KCode>Type</KCode> defaults to <KCode>&quot;text&quot;</KCode>.</Description>
    <Example>
        <KTextInput @bind-Value="textValue" Placeholder="Session name" MaxLength="100" />
        <KText Variant="KTextVariant.Muted">Value: @textValue</KText>
    </Example>
</DemoSection>

<DemoSection Title="KNumberInput&lt;TValue&gt;" Code="@NumberInputSnippet">
    <Description>Generic over any numeric <KCode>struct</KCode> implementing <KCode>IParsable&lt;TValue&gt;</KCode>. <KCode>Value</KCode> is nullable &mdash; wire it manually for non-nullable bound properties.</Description>
    <Example>
        <KNumberInput TValue="double" @bind-Value="numberValue" Step="any" />
        <KText Variant="KTextVariant.Muted">Value: @numberValue</KText>
    </Example>
</DemoSection>

<DemoSection Title="KSelect&lt;TValue&gt;" Code="@SelectSnippet">
    <Description>Wraps <KCode>&lt;select&gt;</KCode>; pass <KCode>&lt;option&gt;</KCode> elements as <KCode>ChildContent</KCode> exactly as you would natively.</Description>
    <Example>
        <KSelect @bind-Value="selectValue">
            <option value="a">Option A</option>
            <option value="b">Option B</option>
        </KSelect>
        <KText Variant="KTextVariant.Muted">Value: @selectValue</KText>
    </Example>
</DemoSection>

<DemoSection Title="KTextArea" Code="@TextAreaSnippet">
    <Description><KCode>resize: vertical</KCode> by default, plus an optional <KCode>Monospace</KCode> flag.</Description>
    <Example>
        <KTextArea @bind-Value="textAreaValue" rows="3" />
    </Example>
</DemoSection>

<DemoSection Title="KCheckbox" Code="@CheckboxSnippet">
    <Description>A <KCode>&lt;label&gt;</KCode> wrapping <KCode>&lt;input type=&quot;checkbox&quot;&gt;</KCode>; bindable via <KCode>Value</KCode> (<KCode>bool</KCode>).</Description>
    <Example>
        <KCheckbox @bind-Value="checkboxValue">Export panorama</KCheckbox>
    </Example>
</DemoSection>

<DemoSection Title="KRange&lt;TValue&gt;" Code="@RangeSnippet">
    <Description>Generic over any <KCode>struct</KCode> implementing <KCode>IParsable&lt;TValue&gt;</KCode>/<KCode>IFormattable</KCode>.</Description>
    <Example>
        <KRange TValue="double" Min="0" Max="1" Step="0.1" @bind-Value="rangeValue">Level</KRange>
        <KText Variant="KTextVariant.Muted">Value: @rangeValue</KText>
    </Example>
</DemoSection>

<DemoSection Title="KFileUpload" Code="@FileUploadSnippet">
    <Description>Wraps Microsoft's built-in <KCode>&lt;InputFile&gt;</KCode>, visually hidden and stretched over the label.</Description>
    <Example>
        <KFileUpload OnChange="HandleFileChange" Accept="image/*">
            <KIcon Name="KIconName.ImageAdd" />
            <span>Choose image</span>
        </KFileUpload>
    </Example>
</DemoSection>

@code {
    private string textValue = "";
    private double? numberValue = 1.6;
    private string selectValue = "a";
    private string textAreaValue = "";
    private bool checkboxValue;
    private double rangeValue = 0.5;

    private void HandleFileChange(InputFileChangeEventArgs args)
    {
    }

    private const string TextInputSnippet = """<KTextInput @bind-Value="SessionName" Placeholder="Session name" MaxLength="100" />""";

    private const string NumberInputSnippet =
        """
        <KNumberInput TValue="double" @bind-Value="Latitude" Step="any" />

        <!-- non-nullable bound property: wire it manually -->
        <KNumberInput TValue="int" Value="@CubemapFaceSize"
                      ValueChanged="@((int? v) => CubemapFaceSize = v ?? CubemapFaceSize)" />
        """;

    private const string SelectSnippet =
        """
        <KSelect @bind-Value="TrialToAssignId">
            <option value="">Add trial</option>
            @foreach (var trial in AvailableTrials)
            {
                <option value="@trial.Id">@trial.Name</option>
            }
        </KSelect>
        """;

    private const string TextAreaSnippet = """<KTextArea @bind-Value="Notes" MaxLength="2000" />""";

    private const string CheckboxSnippet = """<KCheckbox @bind-Value="ExportPanorama">Panorama</KCheckbox>""";

    private const string RangeSnippet = """<KRange TValue="double" Min="0.5" Max="3" Step="0.1" @bind-Value="HeatmapLevel">Level</KRange>""";

    private const string FileUploadSnippet =
        """
        <KFileUpload Disabled="IsBusy" OnChange="OnFileSelectedAsync" Accept=".jpg,.jpeg,.png,image/jpeg,image/png">
            <KIcon Name="KIconName.ImageAdd" />
            <span>Choose image</span>
        </KFileUpload>
        """;
}
