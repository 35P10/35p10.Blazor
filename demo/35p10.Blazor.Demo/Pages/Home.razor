@page "/"

<PageTitle>35p10.Blazor Demo</PageTitle>

<KBlogHeader Title="35p10.Blazor" Meta="Component library" Lead="Reusable Blazor components, shown here in action. Pick a category from the sidebar." Centered="true" />

<KText Variant="KTextVariant.Title" Tag="h2">Getting started</KText>

<DemoSection Title="1. Reference the package" Code="@ReferenceSnippet">
    <Description>As a NuGet package, or as a project reference if you're consuming it from source (e.g. a git submodule, the way <code>GazeLab.Web</code> does).</Description>
</DemoSection>

<DemoSection Title="2. Import the namespace" Code="@ImportSnippet">
    <Description>Add it once to <code>_Imports.razor</code> so every page can use the components without a per-file <code>@@using</code>.</Description>
</DemoSection>

<DemoSection Title="3. Add the stylesheets" Code="@StylesheetSnippet">
    <Description>
        Two stylesheets ship as static web assets under <code>_content/35p10.Blazor/</code>: <code>theme.css</code> (the
        <code>--win98-*</code>/<code>--ui-border*</code> color tokens every component reads) and <code>base.css</code> (base
        typography, link color, and the boxed look for bare <code>&lt;code&gt;</code>/<code>&lt;pre&gt;</code>). Link both
        <em>before</em> your app's own stylesheet, so your app can still override anything it needs to.
        Don't add your own copy of Bootstrap or another CSS framework and expect these components to lean on it for layout —
        every component here is self-contained; if something looks unstyled, it's a missing link tag, not a missing dependency.
    </Description>
</DemoSection>

<KText Variant="KTextVariant.Title" Tag="h2">Components</KText>

<ul class="category-index">
    <li>
        <KCard Href="layout" Class="category-entry">
            <KText Variant="KTextVariant.Caption" Tag="span">Chrome</KText>
            <strong>Layout</strong>
            <KText Variant="KTextVariant.Muted" Tag="span">KCard, KSectionHeader, KSidebarNav.</KText>
        </KCard>
    </li>
    <li>
        <KCard Href="typography" Class="category-entry">
            <KText Variant="KTextVariant.Caption" Tag="span">Text</KText>
            <strong>Typography</strong>
            <KText Variant="KTextVariant.Muted" Tag="span">KText variants and KColor.</KText>
        </KCard>
    </li>
    <li>
        <KCard Href="actions" Class="category-entry">
            <KText Variant="KTextVariant.Caption" Tag="span">Buttons</KText>
            <strong>Actions</strong>
            <KText Variant="KTextVariant.Muted" Tag="span">KButton and its variants.</KText>
        </KCard>
    </li>
    <li>
        <KCard Href="forms" Class="category-entry">
            <KText Variant="KTextVariant.Caption" Tag="span">Inputs</KText>
            <strong>Forms</strong>
            <KText Variant="KTextVariant.Muted" Tag="span">Text, number, select, textarea, checkbox, range, file upload.</KText>
        </KCard>
    </li>
    <li>
        <KCard Href="feedback" Class="category-entry">
            <KText Variant="KTextVariant.Caption" Tag="span">Status</KText>
            <strong>Feedback</strong>
            <KText Variant="KTextVariant.Muted" Tag="span">KBadge, KSpinner, KDialog, KToastStack, KEmptyState.</KText>
        </KCard>
    </li>
    <li>
        <KCard Href="data" Class="category-entry">
            <KText Variant="KTextVariant.Caption" Tag="span">Display</KText>
            <strong>Data</strong>
            <KText Variant="KTextVariant.Muted" Tag="span">KTable, KStatList, KImage, KIcon, KMetaSeparator.</KText>
        </KCard>
    </li>
    <li>
        <KCard Href="blog" Class="category-entry">
            <KText Variant="KTextVariant.Caption" Tag="span">Long-form</KText>
            <strong>Blog</strong>
            <KText Variant="KTextVariant.Muted" Tag="span">KBlogArticle, KBlogHeader, KBlogSection, KBlogToc, KBlogCode.</KText>
        </KCard>
    </li>
</ul>

@code {
    private const string ReferenceSnippet =
        """
        # NuGet
        dotnet add package 35p10.Blazor

        # or, from source (git submodule / local checkout)
        # in your .csproj:
        <ItemGroup>
            <ProjectReference Include="..\35p10.Blazor\src\35p10.Blazor\35p10.Blazor.csproj" />
        </ItemGroup>
        """;

    private const string ImportSnippet =
        """
        @using k35p10.Blazor
        """;

    private const string StylesheetSnippet =
        """
        <link rel="stylesheet" href="_content/35p10.Blazor/theme.css" />
        <link rel="stylesheet" href="_content/35p10.Blazor/base.css" />
        <link rel="stylesheet" href="css/app.css" />
        """;
}
