@page "/blog"

<PageTitle>35p10.Blazor Demo - Blog</PageTitle>

<KBlogArticle InitialSectionId="overview">
    <Header>
        <KBlogHeader Title="Blog" Meta="Article components" Lead="Header, sections, a scroll-spy table of contents, and code blocks for long-form article pages." />
    </Header>
    <ChildContent>
        <KBlogSection Id="overview" Title="Overview">
            <p>
                <KCode>KBlogArticle</KCode> builds the table of contents automatically from the
                <KCode>KBlogSection</KCode> children it renders, and handles smooth-scrolling to a
                section when a TOC entry is clicked.
            </p>
        </KBlogSection>

        <KBlogSection Id="usage" Title="Usage">
            <p>Reference the package and compose an article from sections:</p>
            <KBlogCode Code="@UsageSnippet" />
        </KBlogSection>

        <KBlogSection Id="components" Title="Components">
            <p>The package ships with:</p>
            <KBlogList Items="@ComponentNames" />
        </KBlogSection>

        <KBlogSection Id="theming" Title="Theming">
            <p>
                Styles fall back to sensible defaults but pick up <KCode>--win98-blue</KCode>,
                <KCode>--win98-blue-strong</KCode>, and <KCode>--ui-border</KCode> if the host app
                defines them.
            </p>
        </KBlogSection>
    </ChildContent>
</KBlogArticle>

@code {
    private const string UsageSnippet =
        """
        @using k35p10.Blazor

        <KBlogArticle InitialSectionId="overview">
            <Header>
                <KBlogHeader Title="My Article" Meta="2026-08-08" Lead="A short summary." />
            </Header>
            <ChildContent>
                <KBlogSection Id="overview" Title="Overview">
                    <p>Content goes here.</p>
                </KBlogSection>
            </ChildContent>
        </KBlogArticle>
        """;

    private static readonly string[] ComponentNames =
    [
        "KBlogArticle - layout shell + table-of-contents context",
        "KBlogHeader - title, meta, and lead paragraph (Centered variant for a blog index)",
        "KBlogSection - a titled, anchorable section",
        "KBlogToc - scroll-spy table of contents",
        "KBlogCode - preformatted code block",
        "KBlogList - simple bulleted list",
    ];
}
