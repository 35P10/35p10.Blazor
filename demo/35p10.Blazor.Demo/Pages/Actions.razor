@page "/actions"

<PageTitle>35p10.Blazor Demo - Actions</PageTitle>

<KText Variant="KTextVariant.Title">Actions</KText>
<KText Variant="KTextVariant.Lead">A single button component covering every button look found across the app.</KText>

<DemoSection Title="Variants" Code="@VariantSnippet">
    <Description><KCode>Default</KCode>, <KCode>Primary</KCode>, and <KCode>Danger</KCode> cover most buttons; <KCode>Choice</KCode> is for tab-like or chip-like selectable buttons (pair with <KCode>Active</KCode>).</Description>
    <Example>
        <KButton>Default</KButton>
        <KButton Variant="KButtonVariant.Primary">Primary</KButton>
        <KButton Variant="KButtonVariant.Danger">Danger</KButton>
        <KButton Variant="KButtonVariant.Choice">Choice</KButton>
        <KButton Variant="KButtonVariant.Choice" Active="true">Choice (active)</KButton>
    </Example>
</DemoSection>

<DemoSection Title="Icon-only and links" Code="@IconAndLinkSnippet">
    <Description><KCode>IconOnly</KCode> tightens the padding for a square icon button. Set <KCode>Href</KCode> to render an <KCode>&lt;a&gt;</KCode> instead of a <KCode>&lt;button&gt;</KCode>.</Description>
    <Example>
        <KButton IconOnly="true" title="Refresh" aria-label="Refresh">
            <KIcon Name="KIconName.Refresh" />
        </KButton>
        <KButton Href="#">Link button</KButton>
        <KButton Disabled="true">Disabled</KButton>
    </Example>
</DemoSection>

@code {
    private const string VariantSnippet =
        """
        <KButton>Default</KButton>
        <KButton Variant="KButtonVariant.Primary">Primary</KButton>
        <KButton Variant="KButtonVariant.Danger">Danger</KButton>
        <KButton Variant="KButtonVariant.Choice" Active="@(SelectedId == item.Id)"
                 OnClick="() => Select(item.Id)">
            @item.Label
        </KButton>
        """;

    private const string IconAndLinkSnippet =
        """
        <KButton IconOnly="true" title="Refresh" aria-label="Refresh" OnClick="RefreshAsync">
            <KIcon Name="KIconName.Refresh" />
        </KButton>

        <KButton Href="trials">Go to Trials</KButton>
        <KButton Disabled="@IsBusy">Disabled while busy</KButton>
        """;
}
