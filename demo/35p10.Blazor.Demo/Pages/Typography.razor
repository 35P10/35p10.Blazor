@page "/typography"

<PageTitle>35p10.Blazor Demo - Typography</PageTitle>

<KText Variant="KTextVariant.Title">Typography</KText>
<KText Variant="KTextVariant.Lead">One component, ten variants, an optional color override. Each variant renders a sensible default HTML tag, overridable with <KCode>Tag</KCode>.</KText>

<DemoSection Title="Dashboard scale" Code="@DashboardSnippet">
    <Description>The app-chrome scale: page titles, panel subtitles, body copy, captions, muted meta text.</Description>
    <Example>
        <KText Variant="KTextVariant.Title">Title</KText>
        <KText Variant="KTextVariant.Subtitle">Subtitle</KText>
        <KText Variant="KTextVariant.Body">Body - the default variant.</KText>
        <KText Variant="KTextVariant.Lead">Lead - a slightly larger intro paragraph.</KText>
        <KText Variant="KTextVariant.Caption">Caption - uppercase, small</KText>
        <KText Variant="KTextVariant.Muted">Muted - de-emphasized meta text.</KText>
    </Example>
</DemoSection>

<DemoSection Title="Blog scale" Code="@BlogSnippet">
    <Description>Prefixed <KCode>Blog*</KCode> so they're never confused with the dashboard scale &mdash; used internally by <KCode>KBlogHeader</KCode>/<KCode>KBlogSection</KCode>. See the <a href="blog">Blog</a> page for these in context.</Description>
    <Example>
        <KText Variant="KTextVariant.BlogDisplay">BlogDisplay</KText>
        <KText Variant="KTextVariant.BlogByline">BlogByline</KText>
        <KText Variant="KTextVariant.BlogIntro">BlogIntro - a larger lead for article openings.</KText>
        <KText Variant="KTextVariant.BlogSectionHeading">BlogSectionHeading</KText>
    </Example>
</DemoSection>

<DemoSection Title="KCode" Code="@CodeSnippet">
    <Description>Inline code, styled as a small bordered chip &mdash; the boxed look every bare <KCode>&lt;code&gt;</KCode> tag used to get for free from a global CSS rule, now an explicit component instead.</Description>
    <Example>
        <KText Variant="KTextVariant.Body">Pass <KCode>Href</KCode> to render <KCode>KCard</KCode> as a link.</KText>
    </Example>
</DemoSection>

<DemoSection Title="Color override" Code="@ColorSnippet">
    <Description>Independent of variant size/weight. Reuses the same status colors as <KCode>KBadge</KCode>.</Description>
    <Example>
        <KText Variant="KTextVariant.Body" Color="KColor.Muted">Muted</KText>
        <KText Variant="KTextVariant.Body" Color="KColor.Primary">Primary</KText>
        <KText Variant="KTextVariant.Body" Color="KColor.Danger">Danger</KText>
        <KText Variant="KTextVariant.Body" Color="KColor.Success">Success</KText>
        <KText Variant="KTextVariant.Body" Color="KColor.Warning">Warning</KText>
    </Example>
</DemoSection>

