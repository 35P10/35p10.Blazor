    private const string DashboardSnippet =
        """
        <KText Variant="KTextVariant.Title">Title</KText>
        <KText Variant="KTextVariant.Subtitle">Subtitle</KText>
        <KText Variant="KTextVariant.Body">Body text.</KText>
        <KText Variant="KTextVariant.Lead">Lead paragraph.</KText>
        <KText Variant="KTextVariant.Caption">Caption</KText>
        <KText Variant="KTextVariant.Muted">Muted meta text.</KText>
        """;

    private const string BlogSnippet =
        """
        <KText Variant="KTextVariant.BlogDisplay">Article title</KText>
        <KText Variant="KTextVariant.BlogByline">2026-08-10</KText>
        <KText Variant="KTextVariant.BlogIntro">A larger opening paragraph.</KText>
        <KText Variant="KTextVariant.BlogSectionHeading">Section</KText>
        """;

    private const string CodeSnippet =
