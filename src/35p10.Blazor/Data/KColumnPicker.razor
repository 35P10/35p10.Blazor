@namespace k35p10.Blazor
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@*
    Which columns a table shows and in which order. Reading a table along one column usually means
    putting it next to the first one and getting the rest out of the way, so hiding and reordering
    belong in the same place.

    The list is shown in table order, top to bottom, so that moving a row here and reading the
    table are the same mental operation: a row is dragged where the column should go.
*@

<KDialog IsOpen="IsOpen" Title="@Title" OnClose="OnClose">
    <div class="column-picker">
        @if (ChildContent is not null)
        {
            <KText Variant="KTextVariant.Muted">@ChildContent</KText>
        }

        @if (Header is not null)
        {
            @* Whatever the owner of the table wants above the list: saved sets of columns, a search
               among them, a warning. *@
            <div class="column-picker-header">@Header</div>
        }

        <ul class="column-picker-list" @ref="list">
            @foreach (var column in Columns)
            {
                @* Focusable and answering the arrow keys as well: a drag is a mouse, and the order
                   of the columns should not need one. *@
                <li class="column-picker-item" data-reorder-key="@column.Key" tabindex="0"
                    @onkeydown="@(args => OnKeyAsync(column.Key, args))" @key="column.Key">
                    <span class="column-picker-grip" aria-hidden="true"
                          title="Drag to reorder · arrow keys also work">⠿</span>

                    @if (column.CanBeHidden)
                    {
                        <KCheckbox Value="column.IsVisible"
                                   ValueChanged="@(_ => OnToggle.InvokeAsync(column.Key))">
                            @column.Title
                        </KCheckbox>
                    }
                    else
                    {
                        <span class="column-picker-fixed" title="This column cannot be hidden">
                            @column.Title
                        </span>
                    }
                </li>
            }
        </ul>

        <div class="column-picker-footer">
            <KButton OnClick="OnReset">@ResetText</KButton>
            <KButton Variant="KButtonVariant.Primary" OnClick="OnClose">@DoneText</KButton>
        </div>
    </div>
</KDialog>

@code {
    private const string ModulePath = "./_content/35p10.Blazor/data/list-reorder.js";

    private ElementReference list;
    private IJSObjectReference? module;
    private DotNetObjectReference<KColumnPicker>? self;
    private bool attached;

    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Every column the table could show, in table order. See <see cref="KColumnLayout" />.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<KColumnState> Columns { get; set; } = [];

    [Parameter] public string Title { get; set; } = "Columns";
    [Parameter] public string ResetText { get; set; } = "Reset columns";
    [Parameter] public string DoneText { get; set; } = "Done";

    /// <summary>An optional line of explanation, in the words of whoever owns the table.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Anything to put above the list — saved column sets, for instance.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    [Parameter] public EventCallback<string> OnToggle { get; set; }

    /// <summary>The column and how far it moves: one place earlier or one place later.</summary>
    [Parameter] public EventCallback<(string Key, int Offset)> OnMove { get; set; }

    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    ///     Called by the script when a row is dropped: the column and how far it moved. The list is
    ///     not rearranged in the browser — the owner of the order moves it and this re-renders.
    /// </summary>
    [JSInvokable]
    public Task MovedTo(string key, int offset) => OnMove.InvokeAsync((key, offset));

    private Task OnKeyAsync(string key, KeyboardEventArgs args) => args.Key switch
    {
        "ArrowUp" => OnMove.InvokeAsync((key, -1)),
        "ArrowDown" => OnMove.InvokeAsync((key, 1)),
        _ => Task.CompletedTask,
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone and the listeners went with the page.
        }
        catch (InvalidOperationException)
        {
            // Prerendering: there was never anything attached.
        }

        self?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The list only exists while the dialog is open, so the listener follows it.
        if (!RendererInfo.IsInteractive || attached == IsOpen)
        {
            return;
        }

        try
        {
            if (!IsOpen)
            {
                // The dialog renders nothing when closed, so the list and its listener went with
                // it. Reaching for that element to detach would be reaching for something gone.
                attached = false;

                return;
            }

            module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", ModulePath);
            self ??= DotNetObjectReference.Create(this);

            await module.InvokeVoidAsync("enableReorder", list, self);
            attached = true;
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed while the dialog was being set up.
        }
    }
}
