@namespace k35p10.Blazor

<header class="@CssClass">
    @if (Meta is not null)
    {
        <KText Variant="KTextVariant.BlogByline" Class="blog-meta">@Meta</KText>
    }
    <KText Variant="KTextVariant.BlogDisplay">@Title</KText>
    @if (Lead is not null)
    {
        <KText Variant="KTextVariant.BlogIntro" Class="blog-lead">@Lead</KText>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Meta { get; set; }

    [Parameter]
    public string? Lead { get; set; }

    [Parameter]
    public bool Centered { get; set; }

    private string CssClass => Centered ? "blog-header centered" : "blog-header";
}
