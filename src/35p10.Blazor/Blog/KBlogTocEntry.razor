@namespace k35p10.Blazor

<button type="button"
        class="blog-toc-link @(Context.ActiveSectionId == Section.Id ? "is-active" : null)"
        style="@IndentStyle"
        @onclick="() => Context.ScrollToSectionAsync(Section.Id)">
    <span class="blog-toc-num">@Section.Number.</span>
    <span>@Section.Title</span>
</button>

@foreach (var child in Section.Children)
{
    <KBlogTocEntry Section="child" />
}

@code {
    [CascadingParameter]
    public BlogArticleContext Context { get; set; } = default!;

    [Parameter, EditorRequired]
    public BlogSectionInfo Section { get; set; } = default!;

    private string? IndentStyle => Section.Level > 1 ? $"padding-left: {(Section.Level - 1) * 0.85:0.##}rem;" : null;
}
