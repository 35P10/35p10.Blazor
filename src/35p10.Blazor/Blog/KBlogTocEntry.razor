@namespace k35p10.Blazor
@using System.Globalization

<a href="#@Section.Id"
   class="blog-toc-link @ActiveClass"
   style="@IndentStyle">
    <span class="blog-toc-num">@Section.Number@(Section.Level == 1 ? "." : string.Empty)</span>
    <span>@Section.Title</span>
</a>

@foreach (var child in Section.Children)
{
    <KBlogTocEntry Section="child" />
}

@code {
    [CascadingParameter]
    public BlogArticleContext Context { get; set; } = default!;

    [Parameter, EditorRequired]
    public BlogSectionInfo Section { get; set; } = default!;

    private string? ActiveClass => Context.ActiveSectionId == Section.Id
        ? "is-active"
        : Context.IsAncestorOfActive(Section) ? "is-ancestor" : null;

    private string? IndentStyle
    {
        get
        {
            if (Section.Level <= 1)
            {
                return null;
            }

            var padding = (0.55 + (Section.Level - 1) * 0.9)
                .ToString("0.##", CultureInfo.InvariantCulture);
            return $"padding-left: {padding}rem;";
        }
    }
}
