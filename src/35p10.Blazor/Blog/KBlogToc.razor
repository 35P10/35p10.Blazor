@namespace k35p10.Blazor

<aside class="blog-toc" aria-label="Índice de secciones">
    <p class="blog-toc-label">Índice</p>
    <nav class="blog-toc-nav">
        @foreach (var entry in Context.Sections)
        {
            <button type="button"
                    class="blog-toc-link @(Context.ActiveSectionId == entry.Id ? "is-active" : null)"
                    @onclick="() => Context.ScrollToSectionAsync(entry.Id)">
                <span class="blog-toc-num">@entry.Number.</span>
                <span>@entry.Title</span>
            </button>
        }
    </nav>
</aside>

@code {
    [CascadingParameter]
    public BlogArticleContext Context { get; set; } = default!;
}
