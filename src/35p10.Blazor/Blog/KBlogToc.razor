@namespace k35p10.Blazor

<aside class="blog-toc" aria-label="Índice de secciones">
    <KText Variant="KTextVariant.Caption" Class="blog-toc-label">Índice</KText>
    <nav class="blog-toc-nav">
        @foreach (var entry in Context.Sections)
        {
            <KBlogTocEntry Section="entry" />
        }
    </nav>
</aside>

@code {
    [CascadingParameter]
    public BlogArticleContext Context { get; set; } = default!;
}
