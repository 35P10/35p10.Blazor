@namespace k35p10.Blazor

<section id="@Id" class="blog-section @(_section.Level > 1 ? "is-subsection" : null)">
    <KText Variant="@(_section.Level > 1 ? KTextVariant.BlogSubsectionHeading : KTextVariant.BlogSectionHeading)"
           Class="blog-section-heading">@_section.Number. @Title</KText>
    <div class="blog-section-body">
        <CascadingValue Value="_section" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>
</section>

@code {
    [CascadingParameter]
    public BlogArticleContext Context { get; set; } = default!;

    [CascadingParameter]
    public BlogSectionInfo? Parent { get; set; }

    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private BlogSectionInfo _section = default!;

    protected override void OnInitialized() => _section = Context.RegisterSection(Id, Title, Parent);
}
