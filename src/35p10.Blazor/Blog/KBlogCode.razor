@namespace k35p10.Blazor

<pre class="@CssClass"><code>@if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Code
    }</code></pre>

@code {
    /// <summary>Single-line snippet. Use ChildContent instead for several lines.</summary>
    [Parameter] public string? Code { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Full border instead of the accent bar, for long listings.</summary>
    [Parameter] public bool Boxed { get; set; }

    [Parameter] public string? Class { get; set; }

    private string CssClass =>
        string.Join(' ', new[] { "blog-code", Boxed ? "is-boxed" : null, Class }
            .Where(value => !string.IsNullOrWhiteSpace(value)));
}
