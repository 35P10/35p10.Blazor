@namespace k35p10.Blazor
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="image-cubemap-view">
    <canvas class="image-cubemap-view-canvas"
            @ref="Canvas"
            @onpointerup="ReportCameraAsync"
            @onwheel="ReportCameraAsync"></canvas>
</div>

@code {
    private const string ModulePath = "./_content/35p10.Blazor/stimuli/image-stimulus-3d.js";

    [Parameter] public string AtlasSource { get; set; } = string.Empty;
    [Parameter] public string FrontSource { get; set; } = string.Empty;
    [Parameter] public string RightSource { get; set; } = string.Empty;
    [Parameter] public string BackSource { get; set; } = string.Empty;
    [Parameter] public string LeftSource { get; set; } = string.Empty;
    [Parameter] public string UpSource { get; set; } = string.Empty;
    [Parameter] public string DownSource { get; set; } = string.Empty;
    [Parameter] public bool Active { get; set; } = true;
    [Parameter] public double? MarkerU { get; set; }
    [Parameter] public double? MarkerV { get; set; }
    [Parameter] public bool ShowHeatmap { get; set; }
    [Parameter] public IReadOnlyList<HeatmapPoint> HeatmapPoints { get; set; } = [];
    [Parameter] public double HeatmapLevel { get; set; } = 1.6d;
    [Parameter] public bool ShowMask { get; set; }
    [Parameter] public string? MaskSource { get; set; }
    [Parameter] public double MaskOpacity { get; set; } = 0.6d;
    [Parameter] public EventCallback<string> OnError { get; set; }

    /// <summary>Dirección y apertura impuestas desde fuera, para compartir cámara entre visores.</summary>
    [Parameter] public double? CameraYaw { get; set; }
    [Parameter] public double? CameraPitch { get; set; }
    [Parameter] public double? CameraFov { get; set; }

    /// <summary>Se dispara cuando el usuario mueve la vista, con la cámara resultante.</summary>
    [Parameter] public EventCallback<CameraView> CameraChanged { get; set; }

    private IJSObjectReference? module;
    private IJSObjectReference? viewer;
    private ElementReference Canvas;
    private string? lastStateKey;
    private bool viewerInitialized;

    private object[] BuildHeatmapInteropPoints()
    {
        if (!ShowHeatmap || HeatmapPoints.Count == 0)
        {
            return [];
        }

        return HeatmapPoints
            .Select(point => (object)new
            {
                u = point.U,
                v = point.V,
                intensity = point.Intensity
            })
            .ToArray();
    }

    private double GetHeatmapFingerprint()
    {
        if (!ShowHeatmap || HeatmapPoints.Count == 0)
        {
            return 0d;
        }

        var fingerprint = 0d;
        foreach (var point in HeatmapPoints)
        {
            fingerprint += point.U * 7d + point.V * 13d + point.Intensity * 17d;
        }

        return fingerprint;
    }

    private string StateKey => FormattableString.Invariant(
        $"{string.Join("|", AtlasSource, FrontSource, RightSource, BackSource, LeftSource, UpSource, DownSource)}|m|{MarkerU:0.####}|{MarkerV:0.####}|h|{(ShowHeatmap ? 1 : 0)}|{HeatmapPoints.Count}|{HeatmapLevel:0.##}|{GetHeatmapFingerprint():0.####}|seg|{(ShowMask ? 1 : 0)}|{MaskSource}|{MaskOpacity:0.###}");

    protected override async Task OnParametersSetAsync()
    {
        if (!Active && viewerInitialized)
        {
            lastStateKey = null;
            await DisposeViewerAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Active || !HasRenderableSource())
        {
            return;
        }

        if (viewerInitialized && string.Equals(lastStateKey, StateKey, StringComparison.Ordinal))
        {
            await ApplyCameraAsync();
            return;
        }

        try
        {
            await EnsureViewerAsync();
            await viewer!.InvokeVoidAsync(
                "update",
                new
                {
                    atlas = AtlasSource,
                    front = FrontSource,
                    right = RightSource,
                    back = BackSource,
                    left = LeftSource,
                    up = UpSource,
                    down = DownSource
                },
                MarkerU,
                MarkerV,
                BuildHeatmapInteropPoints(),
                HeatmapLevel,
                ShowMask && !string.IsNullOrWhiteSpace(MaskSource) ? new { atlas = MaskSource } : null,
                MaskOpacity);
            lastStateKey = StateKey;
            await ApplyCameraAsync();
        }
        catch (JSException exception)
        {
            lastStateKey = StateKey;
            await DisposeViewerAsync();
            await OnError.InvokeAsync($"Could not open the cubemap view: {exception.Message}");
        }
    }

    private bool HasRenderableSource() =>
        !string.IsNullOrWhiteSpace(AtlasSource) ||
        (!string.IsNullOrWhiteSpace(FrontSource) &&
            !string.IsNullOrWhiteSpace(RightSource) &&
            !string.IsNullOrWhiteSpace(BackSource) &&
            !string.IsNullOrWhiteSpace(LeftSource) &&
            !string.IsNullOrWhiteSpace(UpSource) &&
            !string.IsNullOrWhiteSpace(DownSource));

    private CameraView? lastCamera;

    private async Task ApplyCameraAsync()
    {
        if (viewer is null || (CameraYaw is null && CameraPitch is null && CameraFov is null))
        {
            return;
        }

        if (lastCamera is not null && lastCamera.Matches(CameraYaw, CameraPitch, CameraFov))
        {
            return;
        }

        var camera = new CameraView(
            CameraYaw ?? lastCamera?.Yaw ?? 0d,
            CameraPitch ?? lastCamera?.Pitch ?? 0d,
            CameraFov ?? lastCamera?.Fov ?? 75d);

        lastCamera = camera;
        try
        {
            await viewer.InvokeVoidAsync("writeCamera", camera.Yaw, camera.Pitch, camera.Fov);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ReportCameraAsync()
    {
        if (viewer is null || !CameraChanged.HasDelegate)
        {
            return;
        }

        try
        {
            var camera = await viewer.InvokeAsync<CameraView>("readCamera");
            lastCamera = camera;
            await CameraChanged.InvokeAsync(camera);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private async Task EnsureViewerAsync()
    {
        module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", ModulePath);
        if (viewer is null)
        {
            viewer = await module.InvokeAsync<IJSObjectReference>("createCubemapStimulusViewer", Canvas);
            viewerInitialized = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeViewerAsync();
        GC.SuppressFinalize(this);
    }

    private async Task DisposeViewerAsync()
    {
        try
        {
            if (viewer is not null)
            {
                await viewer.InvokeVoidAsync("dispose");
                await viewer.DisposeAsync();
            }

            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        finally
        {
            viewer = null;
            module = null;
            viewerInitialized = false;
            lastStateKey = null;
        }
    }
}
