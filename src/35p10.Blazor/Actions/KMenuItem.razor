@namespace k35p10.Blazor

@*
    One action inside a <see cref="KMenuButton" />. A link when it points somewhere — the browser
    has to follow a download itself — and a button when it does something.
*@

@if (!string.IsNullOrWhiteSpace(Href))
{
    <a class="menu-item" role="menuitem" href="@Href" title="@Title" @onclick="CloseAsync">
        @ChildContent
    </a>
}
else
{
    <button type="button" class="menu-item" role="menuitem" title="@Title" @onclick="ChooseAsync">
        @ChildContent
    </button>
}

@code {
    [CascadingParameter] private KMenuButton? Menu { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private async Task ChooseAsync()
    {
        Menu?.Close();

        await OnClick.InvokeAsync();
    }

    private Task CloseAsync()
    {
        Menu?.Close();

        return Task.CompletedTask;
    }
}
