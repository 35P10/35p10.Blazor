<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <RootNamespace>k35p10.Blazor</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>35p10.Blazor</PackageId>
        <Version>1.0.0</Version>
        <Description>Reusable Blazor components for application layouts, data presentation, interaction, and blog-style article pages.</Description>
        <PackageTags>blazor;components;drag-drop;data;blog</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
